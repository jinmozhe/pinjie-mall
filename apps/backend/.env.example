# =============================================
# 后端运行环境变量
# 复制为 .env 并填入真实值，.env 不得入库
# =============================================

PROJECT_NAME="Pinjie Mall Backend"
ENVIRONMENT=local
DEBUG=true

API_V1_STR=/api/v1

# 数据库（连接本地 PostgreSQL）
DATABASE_URL=postgresql+asyncpg://pinjie_mall:your_password@localhost:5432/pinjie_mall_dev
# 测试命令必须显式使用独立的 _test 数据库
TEST_DATABASE_URL=postgresql+asyncpg://pinjie_mall_test:your_password@localhost:5432/pinjie_mall_test

# 阶段 C 认证将 Redis 作为安全关键依赖
REDIS_MODE=required
REDIS_URL=redis://localhost:6379/0
# 集成测试使用独立 Redis DB，禁止与开发数据混用
TEST_REDIS_URL=redis://localhost:6379/15

# 安全边界
WEB_ORIGINS=["https://miniapp.example.com"]
ADMIN_ORIGINS=["http://localhost:3001"]
TRUSTED_HOSTS=["localhost","127.0.0.1","testserver"]
TRUSTED_PROXY_CIDRS=["127.0.0.1/32","::1/128"]
FORCE_HTTPS=false
API_DOCS_ENABLED=true
RELEASE_VERSION=local
LOG_LEVEL=INFO
# 本地文件日志；只读容器可设置为 false，仅保留标准错误流输出
LOG_FILE_ENABLED=true
LOG_FILE_PATH=logs/app_{time:YYYY-MM-DD}.log
LOG_FILE_ROTATION=50 MB
LOG_FILE_RETENTION=10 days
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=5
DB_LOCK_TIMEOUT=5
DEPENDENCY_TIMEOUT=2

# 认证密钥必须分别生成，至少 32 字节且四者互不相同。模板故意留空，禁止直接用于运行。
JWT_ISSUER=pinjie-mall
WEB_JWT_SECRET=
ADMIN_JWT_SECRET=
WEB_TOKEN_HMAC_KEY=
ADMIN_TOKEN_HMAC_KEY=
AUTH_COOKIE_SECURE=false
WEB_ACCESS_TTL_SECONDS=900
ADMIN_ACCESS_TTL_SECONDS=600
REFRESH_IDLE_TTL_DAYS=7
SESSION_ABSOLUTE_TTL_DAYS=30
SESSION_RETENTION_DAYS=30
PASSWORD_HASH_CONCURRENCY=4
WEB_LOGIN_LIMIT=10
ADMIN_LOGIN_LIMIT=5
LOGIN_WINDOW_SECONDS=900

# 可选请求元数据日志
REQUEST_LOG_MODE=disabled
REQUEST_LOG_STREAM_MAXLEN=10000
SECURITY_EVENT_RETENTION_DAYS=180
REQUEST_LOG_RETENTION_DAYS=30

# 文件与多媒体资产存储；SVG 默认禁止，避免同源静态脚本注入
UPLOAD_STORAGE_DRIVER=local
UPLOAD_LOCAL_ROOT=uploads
UPLOAD_BASE_URL=/static/uploads
UPLOAD_MAX_FILE_SIZE_MB=50
UPLOAD_ALLOWED_EXTENSIONS=jpg,jpeg,png,webp,gif,pdf,doc,docx,xls,xlsx,zip
UPLOAD_IO_CONCURRENCY=4

# 系统设置媒体独立于文件资产，两个目录必须是互不嵌套的同级目录
SETTINGS_MEDIA_ROOT=settings-media
SETTINGS_MEDIA_BASE_URL=/static/settings
